<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Ferramenta de desenvolvimento, separada da API: busca semântica na documentação do projeto.
	     Não vai para produção nem entra no build do backend. Por quê: docs/ia/rag-vetorial.md -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<groupId>io.github.k3vinrich4rd</groupId>
	<artifactId>altas-horas-rag</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>altas-horas-rag</name>
	<description>Busca semântica (RAG) na documentação da Barbearia Altas Horas, com Spring AI e pgvector.</description>

	<properties>
		<java.version>25</java.version>
		<!-- Spring AI 2.0.x é a linha do Spring Boot 4 (o 2.0.2 é compilado contra o Boot 4.1.2; conferido no Maven Central). -->
		<spring-ai.version>2.0.2</spring-ai.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- VectorStore em PostgreSQL com a extensão pgvector. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
		</dependency>
		<!-- Embeddings locais (ONNX), sem chave de API e sem custo: o texto não sai da máquina. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-transformers</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
