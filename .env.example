# Copie para .env e preencha. Nunca faça commit do .env.
# Só nomes de variáveis: nenhum valor real neste arquivo.

SPRING_PROFILES_ACTIVE=dev

# Banco local do compose.yaml (perfil dev). Sem preencher, valem os padrões do compose.
POSTGRES_PORTA=
POSTGRES_BANCO=
POSTGRES_USUARIO=
POSTGRES_SENHA=

# Banco de produção (perfil prod): obrigatórias, sem valor padrão
DB_URL=
DB_USUARIO=
DB_SENHA=

# Segurança
# JWT_SEGREDO: 32 bytes ou mais; sem ele a API não sobe (no perfil dev há um padrão só para rodar local).
JWT_SEGREDO=
# CORS_ORIGENS: origens do front separadas por vírgula (dev: http://localhost:3000).
CORS_ORIGENS=

# Primeiro admin: criado na subida só se ainda não existir nenhum. Senha de 10 a 72 bytes; a troca é
# obrigatória no primeiro acesso. Depois de criado, estas variáveis são ignoradas.
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=

# Idempotência da cobrança: segredo do HMAC que compara o corpo sem guardar o CPF
IDEMPOTENCIA_HMAC_SEGREDO=

# Gateway de pagamento (sandbox)
GATEWAY_URL_BASE=
GATEWAY_TOKEN_SANDBOX=
GATEWAY_SEGREDO_WEBHOOK=

# Front (BFF Next.js)
API_URL_BASE=

# Notificação ao barbeiro (Fatia 13): par VAPID do Web Push, gerado uma vez com `npx web-push generate-vapid-keys`.
# Em desenvolvimento pode ficar vazio (as notificações ficam indisponíveis e o aviso do painel continua funcionando).
# A chave privada é segredo: nunca no Git, nunca em log.
APP_NOTIFICACAO_VAPID_PUBLICA=
APP_NOTIFICACAO_VAPID_PRIVADA=
# Canais ligados: webpush (padrão), email (desligado até o Kevin criar a conta no provedor). Vazio = só o painel.
APP_NOTIFICACAO_CANAIS=webpush
