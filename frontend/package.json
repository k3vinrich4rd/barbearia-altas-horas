{
  "name": "altas-horas-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Front-end da Barbearia Altas Horas (Next.js, BFF com cookies HttpOnly)",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "gerar:tokens": "node scripts/gerar-tokens.mjs",
    "gerar:tipos": "openapi-typescript ../docs/contrato/openapi.yaml -o src/api/schema.d.ts",
    "gerar:rotas": "node scripts/gerar-rotas.mjs",
    "verificar:tokens": "node scripts/verificar-tokens.mjs",
    "copiar:assets": "node scripts/copiar-assets.mjs",
    "predev": "npm run copiar:assets",
    "dev": "next dev",
    "prebuild": "npm run copiar:assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.5",
    "openapi-fetch": "0.17.0",
    "qrcode": "1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
