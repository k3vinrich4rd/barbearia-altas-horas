# Só servidor. Endereço da API (nunca NEXT_PUBLIC_).
API_URL=http://localhost:8080
# Navegador. "true" mostra o botão "Simular pagamento" (a API só aceita com app.pagamento.modo=simulado).
NEXT_PUBLIC_PAGAMENTO_SIMULADO=true
# (Fatia 14A) A variável do limite de dias à frente foi apagada: a agenda não tem mais esse limite (D197).
